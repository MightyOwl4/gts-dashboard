{
    "name": "gts-dashboard",
    "version": "0.0.1",
    "private": true,
    "description": "Companion dashboard and configuration tool for the Gate to Stars Starfield modlist",
    "author": "MightyOwl4",
    "license": "MIT",
    "main": "out/main/index.cjs",
    "engines": {
        "node": ">=22.0.0"
    },
    "scripts": {
        "dev": "electron-vite dev",
        "dev:renderer": "vite --config vite.renderer.config.ts",
        "build:bundle": "electron-vite build",
        "build": "electron-vite build && electron-builder --win --config electron-builder.yml",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "format": "prettier --write \"**/*.{ts,tsx,css,html,json,md,yml}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,css,html,json,md,yml}\""
    },
    "dependencies": {
        "@trpc/server": "^10.45.2",
        "electron-trpc": "^0.7.1",
        "zod": "^3.24.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@tanstack/react-query": "^4.36.1",
        "@trpc/client": "^10.45.2",
        "@trpc/react-query": "^10.45.2",
        "@types/node": "^22.10.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@eslint/js": "^9.18.0",
        "typescript-eslint": "^8.20.0",
        "@vitejs/plugin-react": "^4.3.0",
        "electron": "^34.0.0",
        "electron-builder": "^25.1.8",
        "electron-vite": "^3.0.0",
        "eslint": "^9.18.0",
        "eslint-plugin-react": "^7.37.0",
        "eslint-plugin-react-hooks": "^5.1.0",
        "prettier": "^3.4.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0",
        "typescript": "^5.7.0",
        "vite": "^6.0.0",
        "vitest": "^2.1.0"
    }
}
